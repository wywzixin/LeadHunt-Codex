# App
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database
POSTGRES_DB=leadhunt
POSTGRES_USER=leadhunt
POSTGRES_PASSWORD=leadhunt_dev_password
DATABASE_URL=postgresql://leadhunt:leadhunt_dev_password@localhost:5432/leadhunt?schema=public

# Redis / Queue
REDIS_URL=redis://localhost:6379

# GPT-5.5 compatible API
OPENAI_BASE_URL=https://your-openai-compatible-base-url/v1
OPENAI_API_KEY=replace_with_your_gpt55_key
OPENAI_MODEL=gpt-5.5

# Brave Search
BRAVE_SEARCH_API_KEY=replace_with_your_brave_search_key
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1

# Google OAuth / Gmail
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
GMAIL_DAILY_SEND_LIMIT=80
GMAIL_MIN_SEND_INTERVAL_MS=15000
GMAIL_SYNC_INTERVAL_MS=0

# Security
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_random_secret
SESSION_SECRET=replace_with_random_session_secret
