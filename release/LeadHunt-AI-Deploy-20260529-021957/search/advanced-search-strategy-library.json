      "brave_api_auto_execution": true,
      "description_cn": "排除招聘、新闻、培训、消费者、论坛、平台和中国供应商等干扰结果。"
    },
    {
      "id": "or_group",
      "syntax": "A OR B",
      "operator_source": [
        "brave_official"
      ],
      "execution_status": "experimental",
      "google_manual_search": true,
      "brave_api_auto_execution": true,
      "description_cn": "扩展同义词、品牌词、产品词和客户类型词。"
    },
    {
      "id": "and_group",
      "syntax": "A AND B",
      "operator_source": [
        "brave_official"
