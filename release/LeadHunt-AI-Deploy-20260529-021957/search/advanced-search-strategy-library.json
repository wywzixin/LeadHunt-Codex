  "operators": [
    {
      "id": "exact_phrase",
      "syntax": "\"keyword phrase\"",
      "operator_source": [
        "brave_official",
        "google_official"
      ],
      "execution_status": "experimental",
      "google_manual_search": true,
      "brave_api_auto_execution": true,
      "description_cn": "精确匹配品牌、产品、客户类型或行业短语。"
    },
    {
      "id": "exclude_term",
      "syntax": "-term",
      "operator_source": [
        "brave_official",
        "google_official"
      ],
      "execution_status": "experimental",
