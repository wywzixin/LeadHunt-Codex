{
  "mcpServers": {
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--browserUrl=http://127.0.0.1:9222"
      ],
      "env": {},
      "autoApprove": [
        "select_page",
        "list_pages",
        "navigate_page",
        "take_snapshot",
        "click",
        "evaluate_script",
        "fill",
        "take_screenshot",
        "wait_for",
        "new_page",
        "list_network_requests",
        "get_network_request",
        "emulate",
        "type_text"
      ]
    }
  }
}